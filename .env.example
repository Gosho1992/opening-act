# Copy to .env and fill in. Never commit .env.
DEMO_MODE=false
QLOO_API_KEY=your-qloo-hackathon-key
QLOO_BASE_URL=https://hackathon.api.qloo.com
TAVILY_API_KEY=your-tavily-key
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
# Comma-separated origins allowed to call the API from a browser (not needed when the API serves the built frontend)
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_HOUR=30
# Set to true for one live run to refresh backend/fixtures/*.json with real responses
RECORD_FIXTURES=false
